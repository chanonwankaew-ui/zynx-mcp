# Zynx Workflow Mapper — Vite environment variables
# Copy to .env.local for local overrides (never commit .env.local).

# Backend base URL (no trailing slash)
VITE_BACKEND_URL=http://localhost:8787

# MCP wrapper base URL (no trailing slash — /mcp path is appended automatically)
VITE_MCP_URL=http://localhost:3000

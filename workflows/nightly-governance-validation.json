{
  "workflow": {
    "id": "nightly-governance-validation",
    "name": "Nightly Governance Validation",
    "color": "#185FA5",
    "goal": "Review repository governance state, classify deltas, analyze duplicates, and publish a human-reviewable daily report.",
    "schedule": {
      "cron": "0 0 * * *",
      "timezone": "LOCAL"
    },
    "artifacts": {
      "runbook": "ops/governance/governance-runbook.yaml",
      "checklist": "docs/governance/nightly-validation-checklist.md",
      "report_template": "docs/governance/nightly-report-template.md",
      "report_output_dir": "reports/governance"
    },
    "agents": [
      {
        "step": 1,
        "id": "orchestrator",
        "name": "Zynx Orchestrator",
        "role": "Master coordinator",
        "category": "core",
        "estimatedDuration": 2
      },
      {
        "step": 2,
        "id": "data-ingest",
        "name": "Data Ingestion",
        "role": "Load manifest, repository visibility, and governance files",
        "category": "data",
        "estimatedDuration": 5
      },
      {
        "step": 3,
        "id": "validator",
        "name": "Schema Validator",
        "role": "Validate required files, enums, and report structure",
        "category": "data",
        "estimatedDuration": 2
      },
      {
        "step": 4,
        "id": "transformer",
        "name": "Data Transformer",
        "role": "Normalize repository deltas and proposed manifest rows",
        "category": "data",
        "estimatedDuration": 3
      },
      {
        "step": 5,
        "id": "db-agent",
        "name": "DB Agent",
        "role": "Persist reviewed governance state when approved",
        "category": "data",
        "estimatedDuration": 3
      },
      {
        "step": 6,
        "id": "reviewer",
        "name": "Code Reviewer",
        "role": "Check evidence quality and non-destructive safety gates",
        "category": "worker",
        "estimatedDuration": 3
      },
      {
        "step": 7,
        "id": "report-gen",
        "name": "Report Generator",
        "role": "Create daily governance report from template",
        "category": "output",
        "estimatedDuration": 3
      },
      {
        "step": 8,
        "id": "notifier",
        "name": "Notifier",
        "role": "Notify human reviewer when approval is required",
        "category": "output",
        "estimatedDuration": 1
      },
      {
        "step": 9,
        "id": "logger",
        "name": "Logger",
        "role": "Append audit trail and decision log entries",
        "category": "output",
        "estimatedDuration": 1
      }
    ],
    "flow": {
      "nodes": [
        {
          "id": "orchestrator",
          "type": "agent",
          "label": "Zynx Orchestrator",
          "role": "Master coordinator",
          "category": "core",
          "estimatedDuration": 2
        },
        {
          "id": "data-ingest",
          "type": "agent",
          "label": "Data Ingestion",
          "role": "Load manifest, repository visibility, and governance files",
          "category": "data",
          "estimatedDuration": 5
        },
        {
          "id": "validator",
          "type": "agent",
          "label": "Schema Validator",
          "role": "Validate required files, enums, and report structure",
          "category": "data",
          "estimatedDuration": 2
        },
        {
          "id": "transformer",
          "type": "agent",
          "label": "Data Transformer",
          "role": "Normalize repository deltas and proposed manifest rows",
          "category": "data",
          "estimatedDuration": 3
        },
        {
          "id": "db-agent",
          "type": "agent",
          "label": "DB Agent",
          "role": "Persist reviewed governance state when approved",
          "category": "data",
          "estimatedDuration": 3
        },
        {
          "id": "reviewer",
          "type": "agent",
          "label": "Code Reviewer",
          "role": "Check evidence quality and non-destructive safety gates",
          "category": "worker",
          "estimatedDuration": 3
        },
        {
          "id": "report-gen",
          "type": "agent",
          "label": "Report Generator",
          "role": "Create daily governance report from template",
          "category": "output",
          "estimatedDuration": 3
        },
        {
          "id": "notifier",
          "type": "agent",
          "label": "Notifier",
          "role": "Notify human reviewer when approval is required",
          "category": "output",
          "estimatedDuration": 1
        },
        {
          "id": "logger",
          "type": "agent",
          "label": "Logger",
          "role": "Append audit trail and decision log entries",
          "category": "output",
          "estimatedDuration": 1
        }
      ],
      "edges": [
        {
          "source": "orchestrator",
          "target": "data-ingest"
        },
        {
          "source": "data-ingest",
          "target": "validator"
        },
        {
          "source": "validator",
          "target": "transformer"
        },
        {
          "source": "transformer",
          "target": "db-agent"
        },
        {
          "source": "db-agent",
          "target": "reviewer"
        },
        {
          "source": "reviewer",
          "target": "report-gen"
        },
        {
          "source": "report-gen",
          "target": "notifier"
        },
        {
          "source": "notifier",
          "target": "logger"
        }
      ]
    }
  }
}

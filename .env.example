MCP_PORT=3000
MCP_PATH=/mcp

ZYNX_BACKEND_PORT=8787
ZYNX_API_BASE_URL=http://localhost:8787
ZYNX_SERVICE_TOKEN=
ZYNX_DEFAULT_TENANT_ID=dev
ZYNX_DEFAULT_USER_ID=chatgpt-mcp

# CORS — restrict to your domain in production (e.g. https://your-app.example.com)
ZYNX_CORS_ORIGIN=*
ZYNX_ALLOW_FILE_ORIGIN=true

# Set to "true" to return random stubs from GET /agents/:id/health (dev only)
DEV_STUB_HEALTH=false

# LLM provider execution is opt-in. Keep "local" for deterministic CI/dev runs.
ZYNX_LLM_PROVIDER=local
ZYNX_LLM_REQUIRE_PROVIDER=false
ZYNX_LLM_TIMEOUT_MS=30000

# Required only when ZYNX_LLM_PROVIDER=openai.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=

{
  "name": "zynx-mcp-wrapper-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:backend": "tsx src/backend.ts",
    "build": "tsc -p tsconfig.json",
    "workflow:dev": "npm --prefix apps/workflow-mapper run dev",
    "workflow:build": "npm --prefix apps/workflow-mapper run build",
    "workflow:run": "tsx scripts/run-workflow.ts",
    "blueprint:run": "scripts/build-blueprint-explorer.sh run",
    "blueprint:verify": "scripts/build-blueprint-explorer.sh --verify",
    "governance:validate": "tsx scripts/validate-governance.ts",
    "governance:run": "tsx scripts/run-governance.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:backend": "node dist/backend.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}

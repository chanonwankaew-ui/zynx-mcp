{
  "name": "zynx-mcp-wrapper-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "dev:http": "node --import tsx/esm src/http.ts",
    "dev:stdio": "node --import tsx/esm src/stdio.ts",
    "dev:backend": "node --import tsx/esm src/backend.ts",
    "build": "tsc -p tsconfig.json",
    "workflow:dev": "npm --prefix apps/workflow-mapper run dev",
    "workflow:build": "npm --prefix apps/workflow-mapper run build",
    "workflow:run": "tsx scripts/run-workflow.ts",
    "workflow:list": "bash scripts/codex-run-workflow.sh --list",
    "codex:workflow": "bash scripts/codex-run-workflow.sh",
    "blueprint:run": "scripts/build-blueprint-explorer.sh run",
    "blueprint:verify": "scripts/build-blueprint-explorer.sh --verify",
    "governance:validate": "tsx scripts/validate-governance.ts",
    "governance:run": "tsx scripts/run-governance.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:backend": "node dist/backend.js",
    "dev:all": "concurrently -k -n backend,http,vite -c blue,magenta,green \"npm run dev:backend\" \"npm run dev:http\" \"npm run workflow:dev\"",
    "all": "npm run build && npm audit --audit-level=moderate && npm run workflow:run && npm run governance:validate && npm --prefix apps/workflow-mapper run build && npm --prefix apps/workflow-mapper audit --audit-level=moderate"
  },
  "dependencies": {
    "@intercom/messenger-js-sdk": "^0.0.19",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@rive-app/react-canvas": "^4.28.6",
    "axios": "^1.16.1",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "^4.22.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "uuid": "^14.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
